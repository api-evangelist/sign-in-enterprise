      "item": [
        {
          "id": "1b00c079-7510-4bf6-8101-ce9a6f1a6c35",
          "name": "Get the capacity details for a location",
          "request": {
            "name": "Get the capacity details for a location",
            "description": {
              "content": "Gets the details of the future capacity in a location.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locations",
                ":location_id",
                "capacity_forecasts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "hours_to_forecast",
                  "value": "8",
                  "description": "The next N number of hours, the data needs to be calculated. Range from 1 to 24. If not set, it defaults to 8."
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<string>",
                  "description": "ISO8601 timestamp(includes the offset value) to use as the start point for the capacity estimate report. Defaults to the current local timestamp of the location if not provided. Eg: \"2020-07-16T17:05:08-07:00\""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "location_id",
                  "description": "(Required) "
                },
                {
                  "description": " (This can only be one of https://us.tractionguest.com/api/v3,http://localhost:3000/api/v3)",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
