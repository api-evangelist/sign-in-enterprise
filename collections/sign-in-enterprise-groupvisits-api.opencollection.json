{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sign In Solutions VMS AuditLogs GroupVisits API",
    "version": "0.21.0"
  },
  "items": [
    {
      "info": {
        "name": "GroupVisits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Group Visits (Appointments)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{domain}/group_visits",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the results to a specified number. Defaults to 50."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offsets the results to a specified number. Defaults to 0."
              },
              {
                "name": "location_ids",
                "value": "",
                "type": "query",
                "description": "A comma-separated string of locations IDs, to only show group visits (appointments) from those locations."
              },
              {
                "name": "sort_with",
                "value": "",
                "type": "query",
                "description": "A combination of attribute and direction, joined with an underscore, for sorting. Valid attributes are: `created_at`, `updated_at`, `name`, and `start_time`. Valid directions are `asc` and `desc`. E.g., `name_desc`, `start_time_asc`."
              }
            ]
          },
          "docs": "Gets a list of all `GroupVisit` entities (Appointments)."
        },
        {
          "info": {
            "name": "Create a new Group Visit (Appointment)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{domain}/group_visits",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a `GroupVisit` (Appointment)"
        },
        {
          "info": {
            "name": "Get a Group Visit (Appointment)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{domain}/group_visits/:group_visit_id",
            "params": [
              {
                "name": "group_visit_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Gets the details of a single instance of a `GroupVisit`."
        },
        {
          "info": {
            "name": "Update a Group Visit (Appointment)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{domain}/group_visits/:group_visit_id",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_visit_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing `GroupVisit` (Appointment)."
        },
        {
          "info": {
            "name": "Delete a Group Visit (Appointment)",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{domain}/group_visits/:group_visit_id",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_visit_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a single instance of `GroupVisit` (Appointment)."
        }
      ]
    }
  ],
  "bundled": true
